
@startuml
title Диаграммаи фаъолияти китобхонаи онлайн

skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF2F8
  BorderColor #2874A6
  DiamondBackgroundColor #FCF3CF
  DiamondBorderColor #B7950B
  ArrowColor #34495E
}

start

:Кушодани сомонаи китобхона;

if (Навъи истифодабаранда?) then (Меҳмон)
  :Дидани каталоги китобҳо;
  :Ҷустуҷӯи китоб;
  :Дидани маълумоти китоб;
  :Сабти ном ё воридшавӣ;

elseif (Хонанда) then (Хонанда)
  :Воридшавӣ ба ҳисоби шахсӣ;
  :Интихоби китоб;
  :Дидани маълумоти китоб;

  if (Китоб ба дӯстдоштаҳо илова шавад?) then (Ҳа)
    :Илова кардани китоб ба дӯстдоштаҳо;
  else (Не)
    :Идома додани ҷустуҷӯ;
  endif

  if (Файли электронӣ дастрас аст?) then (Ҳа)
    :Кушодани китоби электронӣ;
    :Мутолиаи китоб;
  else (Не)
    :Намоиши паёми дастрас набудани файл;
  endif

else (Администратор)
  :Воридшавӣ ба панели идоракунӣ;
  :Интихоби бахши идоракунӣ;

  if (Идоракунии китобҳо?) then (Ҳа)
    :Интихоби амалиёт;

    if (Илова кардани китоб?) then (Ҳа)
      :Ворид кардани маълумоти китоб;
      :Санҷиши маълумот;
      :Сабти китоби нав;
    else (Не)
      if (Таҳрири китоб?) then (Ҳа)
        :Интихоби китоб;
        :Тағйир додани маълумот;
        :Сабти тағйирот;
      else (Не)
        :Интихоби китоб;
        :Тасдиқи несткунӣ;
        :Нест кардани китоб;
      endif
    endif

  else (Не)
    :Идоракунии категорияҳо;
    :Идоракунии истифодабарандагон;
    :Санҷиши дархостҳои хонандагон;
    :Тасдиқ ё рад кардани дархост;
  endif
endif

:Анҷоми амалиёт;

stop
@enduml
